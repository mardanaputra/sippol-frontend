# ==============================================================================
# SIPPOL Frontend (Next.js 16) Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Backend Proxy / Rewrite Destination (Internal Docker Network)
INTERNAL_BACKEND_URL=http://backend:8000

# Public Browser-facing API URL (Optional, leave blank to use relative proxy /api/*)
NEXT_PUBLIC_API_URL=

# Google reCAPTCHA v2 Checkbox ("I'm not a robot") Public Site Key
# Leave blank to disable reCAPTCHA, or fill with your site key from Google reCAPTCHA Admin Console
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
